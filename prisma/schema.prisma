// Boraqui — schema desenhado para escalar de 1 para centenas de cidades.
// "Enums" são strings validadas em app-level (ver src/lib/constants.ts) em vez de
// enum nativo do Postgres — mantém o schema simples e evita migração de tipo se um
// valor novo precisar ser adicionado sem downtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Geografia ----------

model City {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  state      String // UF, ex: CE
  isActive   Boolean  @default(true)
  launchedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  neighborhoods  Neighborhood[]
  establishments Establishment[]
  addresses      Address[]
  banners        Banner[]

  @@index([state])
}

model Neighborhood {
  id     String @id @default(cuid())
  name   String
  cityId String

  city           City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addresses      Address[]
  establishments Establishment[]

  @@unique([cityId, name])
}

// ---------- Usuários ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  image        String?
  role         String   @default("CUSTOMER") // CUSTOMER | MERCHANT | ADMIN
  createdAt    DateTime @default(now())

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  establishment Establishment?

  @@index([role])
}

model Address {
  id             String  @id @default(cuid())
  userId         String
  label          String // Casa, Trabalho...
  street         String
  number         String
  complement     String?
  reference      String?
  neighborhoodId String
  cityId         String
  isDefault      Boolean @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])
  city         City         @relation(fields: [cityId], references: [id])
  orders       Order[]

  @@index([userId])
}

// ---------- Planos ----------

model Plan {
  id           String  @id @default(cuid())
  slug         String  @unique // FREE | BRONZE | PRATA | OURO
  name         String
  maxProducts  Int? // null = ilimitado
  highlighted  Boolean @default(false)
  priceMonthly Float   @default(0)
  featuresJson String  @default("[]") // string[] em JSON

  establishments Establishment[]
}

// ---------- Categorias ----------

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  icon  String @default("utensils")
  order Int    @default(0)

  establishments EstablishmentCategory[]
  products       Product[]
}

// ---------- Estabelecimentos ----------

model Establishment {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  ownerId            String?   @unique
  cityId             String
  neighborhoodId     String?
  logoUrl            String?
  coverUrl           String?
  description        String?
  whatsapp           String
  instagram          String?
  pixKey             String?
  serviceAreaNote    String?
  deliveryFee        Float     @default(0)
  avgDeliveryTimeMin Int       @default(40)
  openingHoursJson   String    @default("{}") // { mon: [["08:00","22:00"]], ... }
  status             String    @default("PENDING") // PENDING | APPROVED | SUSPENDED
  isPaused           Boolean   @default(false) // "fechado temporariamente"
  vacationUntil      DateTime?
  planId             String?
  ratingAvg          Float     @default(0)
  ratingCount        Int       @default(0)
  ordersCount        Int       @default(0)
  createdAt          DateTime  @default(now())

  city         City                    @relation(fields: [cityId], references: [id])
  neighborhood Neighborhood?           @relation(fields: [neighborhoodId], references: [id])
  owner        User?                   @relation(fields: [ownerId], references: [id])
  plan         Plan?                   @relation(fields: [planId], references: [id])
  categories   EstablishmentCategory[]
  menuSections MenuSection[]
  products     Product[]
  additions    AdditionItem[]
  coupons      Coupon[]
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]

  @@index([cityId, status])
}

model EstablishmentCategory {
  establishmentId String
  categoryId       String

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([establishmentId, categoryId])
}

model Favorite {
  userId          String
  establishmentId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([userId, establishmentId])
}

// ---------- Cardápio ----------

model MenuSection {
  id              String @id @default(cuid())
  establishmentId String
  name            String
  order           Int    @default(0)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      Product[]
}

model Product {
  id              String   @id @default(cuid())
  establishmentId String
  menuSectionId   String?
  categoryId      String?
  name            String
  description     String?
  imageUrl        String?
  price           Float
  promoPrice      Float?
  isCombo         Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  soldCount       Int      @default(0)
  createdAt       DateTime @default(now())

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  menuSection   MenuSection?   @relation(fields: [menuSectionId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  additions     AdditionItem[] @relation("ProductAdditions")
  orderItems    OrderItem[]

  @@index([establishmentId, isAvailable])
}

model AdditionItem {
  id              String @id @default(cuid())
  establishmentId String
  name            String
  price           Float  @default(0)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      Product[]     @relation("ProductAdditions")
}

// ---------- Cupons ----------

model Coupon {
  id              String    @id @default(cuid())
  establishmentId String?
  code            String    @unique
  type            String    @default("PERCENT") // PERCENT | FIXED
  value           Float
  minOrderValue   Float     @default(0)
  maxUses         Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
}

// ---------- Banners / Campanhas ----------

model Banner {
  id       String    @id @default(cuid())
  cityId   String? // null = todas as cidades
  title    String
  imageUrl String
  linkUrl  String?
  order    Int       @default(0)
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  city City? @relation(fields: [cityId], references: [id])
}

// ---------- Pedidos ----------

model Order {
  id              String   @id @default(cuid())
  code            String   @unique
  customerId      String
  establishmentId String
  addressId       String?
  paymentMethod   String // PIX | DINHEIRO | CARTAO
  subtotal        Float
  deliveryFee     Float
  discount        Float    @default(0)
  total           Float
  couponId        String?
  observations    String?
  status          String   @default("SENT_TO_WHATSAPP") // PENDING | SENT_TO_WHATSAPP | CONFIRMED | CANCELLED
  createdAt       DateTime @default(now())

  customer      User          @relation(fields: [customerId], references: [id])
  establishment Establishment @relation(fields: [establishmentId], references: [id])
  address       Address?      @relation(fields: [addressId], references: [id])
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  review        Review?

  @@index([customerId])
  @@index([establishmentId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  name          String
  unitPrice     Float
  quantity      Int
  observations  String?
  additionsJson String  @default("[]") // [{name, price}]

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

// ---------- Avaliações ----------

model Review {
  id             String   @id @default(cuid())
  establishmentId String
  customerId     String
  orderId        String?  @unique
  foodRating     Int
  serviceRating  Int
  deliveryRating Int
  comment        String?
  createdAt      DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      User          @relation(fields: [customerId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])

  @@index([establishmentId])
}

// ---------- Notificações ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String? // null = broadcast platform-wide
  title     String
  body      String
  type      String   @default("GERAL") // PROMOCAO | CUPOM | NOVO_ESTABELECIMENTO | PEDIDO_ENVIADO | PEDIDO_CONFIRMADO | GERAL
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
