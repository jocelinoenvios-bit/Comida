# Copie para .env e preencha os valores.

# Postgres. Para dev local: suba com `docker compose up -d db` e use a URL abaixo.
# Em produção, aponte para seu banco gerenciado (Neon, Supabase, Vercel Postgres, RDS...).
DATABASE_URL="postgresql://boraqui:boraqui_dev_password@localhost:5432/boraqui"

# NextAuth — gere um valor forte com: openssl rand -base64 32
AUTH_SECRET="change-me"
# URL pública do app (sem barra no final). Em produção: https://seu-dominio.com
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (login com Google) — crie credenciais em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
